# Meditation Philosophy Database — Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# DATABASE
# =============================================================================
# Option 1: Neon (Recommended for production)
# Get your connection string from: Neon Console > Project > Connection Details
# Include ?sslmode=require — the app takes SSL from the URL; any non-local host
# is auto-detected as remote and gets resilient pooling (pre-ping, keepalives).
# DB_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Option 2: Local Docker PostgreSQL (for development)
# DB_URL=postgresql://journalling:journalling@localhost:5433/journalling_dev

# Option 3: Direct connection (legacy - also works)
# DATABASE_URL=postgresql://user:password@host:port/database

DB_URL=postgresql://journalling:journalling@localhost:5433/journalling_dev

# Direct (non-pooled) Neon connection string — REQUIRED by the SuttaCentral
# ingestion CLIs (scripts/ingest_one.py, scripts/ingest_batch.py), which point
# the app database and vector store at it; they exit if it is unset.
# NEON_DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Database pool settings (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# =============================================================================
# EMBEDDING SERVICES
# =============================================================================
# Voyage AI - For production embeddings (voyage-3.5 model)
# Get your API key from: https://dash.voyageai.com/
VOYAGE_API_KEY=your-voyage-api-key-here

# Embedding settings (optional - defaults shown)
# EMBEDDING_VOYAGE_MODEL=voyage-3.5
# EMBEDDING_BATCH_SIZE=100
# EMBEDDING_HUGGINGFACE_MODEL=BAAI/bge-small-en-v1.5

# =============================================================================
# DOCUMENT PARSING
# =============================================================================
# LlamaParse - For PDF parsing with LLM-powered extraction
# Get your API key from: https://cloud.llamaindex.ai/
LLAMAPARSE_API=your-llamaparse-api-key-here

# Parsing settings (optional)
# PARSING_HIGH_RES_OCR=true

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# HuggingFace token (for some private models)
# HF_TOKEN=your-huggingface-token-here

# =============================================================================
# LLM PROVIDER (query layer + eval notebooks)
# =============================================================================
# Options: groq | ollama | openai
# Default: groq (uses GROQ_API_KEY below)
LLM_PROVIDER=ollama

# Model override (uses provider default if unset)
# groq default:   llama-3.3-70b-versatile
# ollama default: qwen2.5:7b
# openai default: gpt-4o-mini
LLM_MODEL=qwen2.5:7b

# Ollama server URL (only needed for LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Groq API key (only needed for LLM_PROVIDER=groq)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# LANGFUSE TRACING (optional)
# =============================================================================
# Langfuse can capture retrieval + answer traces from the RAG playground.
# Cloud: https://cloud.langfuse.com
# Self-hosted: set LANGFUSE_BASE_URL to your deployment URL.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=local-dev

# =============================================================================
# CHUNKING SETTINGS (optional - defaults shown)
# =============================================================================
# CHUNKING_MAX_SIZE=2000
# CHUNKING_MIN_SIZE=700
# CHUNKING_MAX_HEADER_LEVEL=6
# CHUNKING_ENABLE_SEMANTIC=true
# CHUNKING_ENABLE_PARALLEL=true
# CHUNKING_MAX_WORKERS=4
# CHUNKING_TINY_CHUNK_THRESHOLD=50
